<?xml version="1.0" encoding="UTF-8"?>

<web-app
    xmlns="http://xmlns.jcp.org/xml/ns/javaee"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="
        http://xmlns.jcp.org/xml/ns/javaee
        http://xmlns.jcp.org/xml/ns/javaee/web-app_3_1.xsd"
    version="3.1">

    <!-- Project Name -->
    <display-name>VirtualTouristGuide</display-name>

    
    <!-- PlaceServlet Declaration -->
    
    <servlet>
        <servlet-name>PlaceServlet</servlet-name>
        <servlet-class>backend.PlaceServlet</servlet-class>
    </servlet>

    <!-- URL Mapping -->
    <servlet-mapping>
        <servlet-name>PlaceServlet</servlet-name>
        <url-pattern>/PlaceServlet</url-pattern>
    </servlet-mapping>

    
    <!-- Welcome Page -->
    <welcome-file-list>
        <welcome-file>index.html</welcome-file>
    </welcome-file-list>

    <servlet>
    <servlet-name>ChatbotServlet</servlet-name>
    <servlet-class>backend.ChatbotServlet</servlet-class>
    </servlet>

    <servlet-mapping>
    <servlet-name>ChatbotServlet</servlet-name>
    <url-pattern>/ChatbotServlet</url-pattern>
    </servlet-mapping>

    <servlet>
    <servlet-name>RegisterServlet</servlet-name>
    <servlet-class>backend.RegisterServlet</servlet-class>
</servlet>

<servlet-mapping>
    <servlet-name>RegisterServlet</servlet-name>
    <url-pattern>/RegisterServlet</url-pattern>
</servlet-mapping>

<servlet>
    <servlet-name>LoginServlet</servlet-name>
    <servlet-class>backend.LoginServlet</servlet-class>
</servlet>

<servlet-mapping>
    <servlet-name>LoginServlet</servlet-name>
    <url-pattern>/LoginServlet</url-pattern>
</servlet-mapping>

<servlet>
    <servlet-name>LogoutServlet</servlet-name>
    <servlet-class>backend.LogoutServlet</servlet-class>
</servlet>

<servlet-mapping>
    <servlet-name>LogoutServlet</servlet-name>
    <url-pattern>/LogoutServlet</url-pattern>
</servlet-mapping>


<servlet>
    <servlet-name>ProfileServlet</servlet-name>
    <servlet-class>backend.ProfileServlet</servlet-class>
</servlet>

<servlet-mapping>
    <servlet-name>ProfileServlet</servlet-name>
    <url-pattern>/ProfileServlet</url-pattern>
</servlet-mapping>

<servlet>
    <servlet-name>SessionCheckServlet</servlet-name>
    <servlet-class>backend.SessionCheckServlet</servlet-class>
</servlet>

<servlet-mapping>
    <servlet-name>SessionCheckServlet</servlet-name>
    <url-pattern>/SessionCheckServlet</url-pattern>
</servlet-mapping>

</web-app>